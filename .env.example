# FreeProxyPool 环境变量示例（v0.1.0）
#
# 用法：  cp .env.example .env  &&  nano .env
# 生效：  docker compose up -d --build
#
# 标 【必填】 的变量未设置时 docker compose 会直接报错退出 —— 这是刻意设计：
# 宁可起不来，也不要默默用弱口令/空密钥对外服务。
# 本文件本身不含任何真实密钥，可以安全提交到 git（.env 已被 .gitignore 忽略）。

# ============ 必填：安全底线 ============

# 对外 API 鉴权密钥。开启后 /get/ /batch/ /pop/ /all/ /count/ /delete/ /report/ /stats/ /metrics
# 都要求请求头 API-KEY: <值>。留空 = 完全不鉴权（仅限受控内网自测）。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEY=

# 管理后台口令。要求：长度 ≥ 10，且大写/小写/数字/特殊字符中至少命中 3 类。
# 写入 Redis 前会被 PBKDF2-HMAC-SHA256（12 万次迭代 + 16 字节随机盐）哈希，明文不落库。
# 仍使用默认口令时，首次登录会被强制跳转改密页（ADMIN_FORCE_PASSWORD_CHANGE）。
# 生成：python -c "import secrets;print('Fp#'+secrets.token_urlsafe(14))"
ADMIN_PASSWORD=

# ============ Redis ============

# Redis requirepass 口令（compose 会同时注入 redis 服务与各应用服务）
REDIS_PASSWORD=fpp_redis_2024

# ============ 网关 ============

# Nginx 映射到宿主机的端口
HTTP_PORT=5020

# 可信反向代理网段（逗号分隔 CIDR）。只有直连来源命中这些网段时才采信
# X-Forwarded-For。默认留空 = 完全不采信 XFF，一律用 TCP 对端地址 —— 配合项目
# 自带的 Nginx（应用不直连外网）这是最安全的选择，也能防止伪造 XFF 绕过登录锁定。
TRUSTED_PROXIES=

# 告警 Webhook（钉钉 / 企业微信群机器人），留空则只写日志与后台告警面板
ALERT_WEBHOOK=

# ============ 延迟分层（tier） ============
# 代理延迟按阈值分成 fast / medium / slow 三档（另有 unknown = 尚无延迟样本）。
# 单位毫秒；调低 fast 阈值 = 收窄"快"的定义。留空用默认值（500 / 2000）。
# 也可在管理后台「配置 → 存储」里改，后台保存后 ≤2 秒生效。
TIER_FAST_MS=500
TIER_MEDIUM_MS=2000

# ============ MySQL 冷存储归档（--profile archive 时生效，默认关闭） ============
# 四张表只服务"事后追溯"：proxy_history / access_log / source_config / system_config，
# 不参与实时代分发与校验。关闭时用 `docker compose up -d` 即可，无需启动 mysql。

MYSQL_ENABLED=false
MYSQL_ROOT_PASSWORD=
MYSQL_USER=fpp
MYSQL_PASSWORD=
MYSQL_DATABASE=fpp
